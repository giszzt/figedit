# figedit 图像后端密钥配置模板
#
# 用法：复制本文件为同目录下的 `.env`，填入你有的密钥即可（有哪个填哪个）。
# 脚本会自动读取；系统环境变量里已有的同名变量优先于本文件。
# `.env` 已被 .gitignore 排除，不会被提交。

# ---- Labnana（聚合网关，支持 GPT-Image-2 / Gemini / Nano Banana）----
LABNANA_API_KEY=
# 可选，默认官方网关地址：
# LABNANA_BASE_URL=

# ---- Google Gemini 官方 ----
# 两个变量名任填其一：
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# 可选，默认 gemini-3-pro-image：
# FIGEDIT_GEMINI_IMAGE_MODEL=

# ---- OpenAI 官方 ----
OPENAI_API_KEY=
# 可选，默认 gpt-image-2：
# FIGEDIT_OPENAI_IMAGE_MODEL=

# ---- 高级选项 ----
# 强制指定脚本后端（跳过自动顺序）：labnana-gpt-image-2 / labnana-nano-banana / openai-official / gemini-official
# FIGEDIT_CLEAN_PLATE_BACKEND=
# 自定义命令适配器配置 JSON 路径：
# FIGEDIT_CLEAN_PLATE_CONFIG=
