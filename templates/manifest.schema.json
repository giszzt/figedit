{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FigEdit Background Aware Manifest",
  "type": "object",
  "required": [
    "project",
    "source_image",
    "canvas",
    "classification",
    "assets",
    "elements"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "source_image": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "background": {
          "type": "string"
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "layout_topology",
        "complexity",
        "style_type",
        "reconstruction_mode"
      ],
      "properties": {
        "layout_topology": {
          "type": "string"
        },
        "complexity": {
          "type": "string"
        },
        "style_type": {
          "type": "string"
        },
        "reconstruction_mode": {
          "type": "string"
        },
        "reconstruction_intent": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "route_decision": {
      "type": "object",
      "description": "Global Reconstruction Read lock. Optional for legacy manifests; expected on new tasks.",
      "required": [
        "source",
        "editability_depth",
        "validation_tier",
        "exception_ids"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "source": {
          "enum": ["fresh-global-read", "user-directive", "global-read"]
        },
        "route_status": {
          "enum": ["ready", "needs-user-input"]
        },
        "editability_depth": {
          "enum": ["text-only", "text+structure", "selective-assets", "full-extract"]
        },
        "base_strategy": {
          "const": "svg-rebuild"
        },
        "background_scopes": {
          "type": "array",
          "items": {"$ref": "#/$defs/backgroundScope"}
        },
        "asset_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/assetRouteGroup"}
        },
        "unresolved_decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/unresolvedDecision"}
        },
        "reconstruction_route": {
          "enum": ["regular-hybrid", "ai-clean-plate"]
        },
        "validation_tier": {
          "enum": ["svg-primary", "pptx-triggered"]
        },
        "exception_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "oneOf": [
        {
          "required": ["schema_version", "route_status", "base_strategy", "background_scopes", "asset_groups", "unresolved_decisions"],
          "properties": {
            "source": {"enum": ["fresh-global-read", "user-directive"]}
          }
        },
        {
          "required": ["reconstruction_route"],
          "not": {"required": ["schema_version"]},
          "properties": {
            "source": {"enum": ["global-read", "user-directive"]}
          }
        }
      ]
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "strategy": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "source_mode": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "pad": {
            "type": "number"
          },
          "source_region": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
          "panel_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "asset_fidelity": {
            "type": "string"
          },
          "decision_reason": {
            "type": "string"
          },
          "background_handling": {
            "type": "string"
          },
          "crop_status": {
            "type": "string"
          },
          "text_policy": {
            "type": "string"
          },
          "edge_check": {
            "type": "object"
          },
          "generation_provenance": {
            "type": "object"
          },
          "review_status": {
            "type": "string"
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "panel_id": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "subtype": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "rx": {
            "type": "number"
          },
          "ry": {
            "type": "number"
          },
          "r": {
            "type": "number"
          },
          "points": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "latex": {
            "type": "string"
          },
          "math_format": {
            "type": "string"
          },
          "formula_policy": {
            "type": "string"
          },
          "formula_decision_reason": {
            "type": "string"
          },
          "text_anchor": {
            "type": "string"
          },
          "dominant_baseline": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "font_size": {
            "type": "number"
          },
          "font_weight": {
            "type": "string"
          },
          "font_family": {
            "type": "string"
          },
          "fill": {
            "type": "string"
          },
          "stroke": {
            "type": "string"
          },
          "stroke_width": {
            "type": "number"
          },
          "dasharray": {
            "type": "string"
          },
          "opacity": {
            "type": "number"
          },
          "asset_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "source_bbox": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
          "confidence": {
            "type": "number"
          },
          "detector": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "style_source": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "d": {
            "type": "string"
          },
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          },
          "arrow_start": {
            "type": "boolean"
          },
          "arrow_end": {
            "type": "boolean"
          },
          "marker_start": {
            "$ref": "#/$defs/markerSpec"
          },
          "marker_end": {
            "$ref": "#/$defs/markerSpec"
          },
          "marker_mid": {
            "$ref": "#/$defs/markerSpec"
          },
          "connector_clearance": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          },
          "decision_reason": {
            "type": "string"
          },
          "asset_fidelity": {
            "type": "string"
          },
          "background_handling": {
            "type": "string"
          }
        }
      }
    },
    "background_plan": {
      "type": "object",
      "description": "Only for ai-clean-plate. Conventional routes omit this field.",
      "required": [
        "strategy",
        "route_decision",
        "plate_asset_id",
        "generation_provenance",
        "candidate_review"
      ],
      "properties": {
        "strategy": {
          "const": "ai-clean-plate"
        },
        "route_decision": {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "source": {
              "enum": ["background-gate", "user-directive"]
            },
            "crop_svg_recoverable": {
              "type": "boolean"
            }
          }
        },
        "plate_asset_id": {
          "type": "string"
        },
        "generation_provenance": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string"
            },
            "backend": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "skill": {
              "type": "string"
            },
            "prompt_file": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "references": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output": {
              "type": "string"
            }
          }
        },
        "candidate_review": {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "checks": {
              "type": "object"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "review_status": {
          "type": "string"
        },
        "foreground_mode": {
          "enum": ["full-extract", "selective", "flatten"]
        },
        "foreground_mode_source": {
          "enum": ["user-choice", "explicit-request", "auto-default"]
        }
      }
    },
    "background_plans": {
      "type": "array",
      "items": {"$ref": "#/$defs/backgroundPlanV2"}
    },
    "style_tokens": {
      "type": "object"
    },
    "diagnostics": {
      "type": "object"
    },
    "recognition_summary": {
      "type": "object"
    },
    "asset_decision_policy": {
      "type": "object"
    },
    "editability_targets": {
      "type": "object"
    },
    "quality_gates": {
      "type": "object"
    }
  },
  "$defs": {
    "sourceRegion": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "backgroundScope": {
      "type": "object",
      "required": ["id", "source_region", "region_accuracy", "field_type", "strategy", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_region": {"$ref": "#/$defs/sourceRegion"},
        "region_accuracy": {"enum": ["estimated-from-global-read", "measured"]},
        "field_type": {"enum": ["continuous-field", "self-contained-raster"]},
        "strategy": {"enum": ["ai-clean-plate", "source-preserve-region"]},
        "foreground_mode": {"enum": ["flatten", "selective", "full-extract", "pending-user-choice"]},
        "foreground_inventory": {
          "type": "array",
          "items": {"$ref": "#/$defs/foregroundInventoryItem"}
        },
        "reason": {"type": "string", "minLength": 1},
        "user_directive": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "ai-clean-plate"}}},
          "then": {"required": ["foreground_mode"]}
        },
        {
          "if": {"properties": {"foreground_mode": {"const": "pending-user-choice"}}},
          "then": {
            "required": ["foreground_inventory"],
            "properties": {"foreground_inventory": {"minItems": 1}}
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {"const": "source-preserve-region"},
              "field_type": {"const": "continuous-field"}
            },
            "required": ["strategy", "field_type"]
          },
          "then": {"required": ["user_directive"]}
        }
      ]
    },
    "assetRouteGroup": {
      "type": "object",
      "required": ["strategy", "ids", "separability", "reason"],
      "properties": {
        "strategy": {"enum": ["redraw", "crop", "regenerate-chroma", "flatten", "preserve-raster", "omit"]},
        "separability": {"enum": ["not-applicable", "clean", "clean-on-fill", "contaminated", "embedded-in-continuous-field"]},
        "observed_overlap": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "crop"}}},
          "then": {"properties": {"separability": {"enum": ["clean", "clean-on-fill"]}}}
        },
        {
          "if": {"properties": {"strategy": {"const": "regenerate-chroma"}}},
          "then": {"properties": {"separability": {"const": "contaminated"}}}
        },
        {
          "if": {"properties": {"separability": {"const": "contaminated"}}},
          "then": {"required": ["observed_overlap"]}
        }
      ]
    },
    "foregroundInventoryItem": {
      "type": "object",
      "required": ["id", "kind", "resolved_strategy"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "source-specific-visual"},
        "resolved_strategy": {"enum": ["pending-user-choice", "flatten", "regenerate-chroma"]},
        "notes": {"type": "string"}
      }
    },
    "unresolvedDecision": {
      "type": "object",
      "required": ["id", "type", "question"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["foreground-depth", "raster-preservation", "fidelity-tradeoff"]},
        "scope_id": {"type": "string"},
        "asset_id": {"type": "string"},
        "question": {"type": "string"}
      }
    },
    "backgroundPlanV2": {
      "type": "object",
      "required": ["scope_id", "strategy", "source_region", "foreground_mode", "foreground_mode_source", "route_reason", "plate_asset_id", "generation_provenance", "candidate_review"],
      "properties": {
        "scope_id": {"type": "string", "minLength": 1},
        "strategy": {"const": "ai-clean-plate"},
        "source_region": {"$ref": "#/$defs/sourceRegion"},
        "foreground_mode": {"enum": ["full-extract", "selective", "flatten"]},
        "foreground_mode_source": {"enum": ["user-choice", "explicit-request", "auto-default"]},
        "route_reason": {"type": "string", "minLength": 1},
        "plate_asset_id": {"type": "string", "minLength": 1},
        "generation_provenance": {"type": "object"},
        "candidate_review": {
          "type": "object",
          "required": ["accepted"],
          "properties": {"accepted": {"const": true}}
        },
        "review_status": {"type": "string"}
      }
    },
    "markerSpec": {
      "type": ["object", "null"],
      "properties": {
        "style": {
          "enum": ["solid-triangle", "open-chevron", "circle", "diamond"]
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
